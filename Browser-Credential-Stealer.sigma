id: xxT1555.003
title: Browser Credential Stealer
status: development
version: 1.0
description: Adversaries may acquire credentials from web browsers by reading files specific to the target browser. Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future. Web browsers typically store the credentials in an encrypted format within a credential store; however, methods exist to extract plaintext credentials from web browsers.
author: Kynan Jones
reference: 
    - https://www.splunk.com/en_us/blog/security/do-not-cross-the-redline-stealer-detections-and-analysis.html
    - xxx
logsource:
    product: windows
    service: security
detection:
    event_selection:
        EventID: '4663'
    target_paths:
        object_file_path: '*\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Login Data'
        object_file_path: '*\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Local Extension Settings\\*'
        object_file_path: '*\\AppData\\Local\\Google\\Chrome\\User Data\\Local State'
        Object_Name: '*\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles*'

    filter:
        process_path: '*:\\Windows\\explorer.exe`
        process_path: '*:\\Windows\\System32\\dllhost.exe'
        process_path: '*\\chrome.exe'
        process_path: '*\\firefox.exe'
   
    condition: event_selection and any of target_paths and not filter
fields:
//
//
falsepositives: N/A
severity: 5
//
tags:
    - attack.T1555.003
    - attack.T1555
