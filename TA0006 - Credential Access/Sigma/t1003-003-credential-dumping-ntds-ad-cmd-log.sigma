title: T1003-003 - NTDS-Credential-Dumping-Shadowcopy-
id: 0f06a3a5-6a09-413f-8743-e6cf35561299
description: Variant of NTDS Credential Dumping Without Application logs. If the TA has no credentials, but have access to the DC, it's possible to dump the ntds using a lolbin ntdsutil.exe. This use case will be applicable if application logging is not in use, however if b64 encoding is used by threat actor this may be circumvented. Command line arguments for null argument entries to combat obfuscation.
author: KJ
status: development
date: 2023/11/23
tags:
    - attack.credential_access
    - attack.t1003-003
references: 
    - https://www.ired.team/offensive-security/credential-access-and-credential-dumping/ntds.dit-enumeration
    - https://www.youtube.com/watch?v=rioVumJB0Fo&ab_channel=13Cubed
    - https://attack.mitre.org/techniques/T1003/003/
logsource:
  product: windows
  service: security
detection:
  selection_1:
    - EventID: 4688
  selection_2:
    CreatorProcessName|endswith:
      - "\\cmd.exe"
      - "\\powershell.exe"

  dump_cmdlets:
    ProcessCommandLine|contains|all:
      - ".txt"
      - "/s"
    NewProcessName|endswith:
      - "\\diskshadow.exe"

  copy_cmdlets:
    NewProcessName|endswith:
    - "\\cmd.exe" 
    ProcessCommandLine|contains|all:
     - "/c copy"
     - "ntds.dit"
     - ":\\"

  condition:
    selection_1 and selection_2 and (dump_cmdlets or copy_cmdlets)
  level: high


